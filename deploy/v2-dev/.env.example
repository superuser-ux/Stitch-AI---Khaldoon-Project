# #389 — v2-dev lane environment TEMPLATE (non-secret). Copy to `.env` (git-ignored) and fill at runtime.
# NEVER commit real values. Phase-A packaging validation needs no real secret — packaging_test.sh injects
# synthetic sentinels at runtime only. A future DEPLOYMENT directive (separate release) owns real
# development-only secret generation, stored at mode 0600 under the candidate path, never here.

# Exact 40-char reviewed build SHA. Selects the transferred app-image tags
# (tanaghom-v2-dev-{gateapi,workbench}:<sha>, restored by ./load-images.sh) AND is asserted at gateapi
# startup against the baked /work/BUILD_SHA. The runtime compose has no build context; images are loaded
# from the transferred OCI archives before `docker compose up`.
V2DEV_GIT_SHA=

# --- runtime secrets (injected at deploy/validate time only; leave blank in any committed copy) ---
# Single DB credential source (interpolated as POSTGRES_PASSWORD and gateapi DB_PASSWORD).
DB_PASSWORD=
# #387 — REVIEWER_PROXY_SECRET is NO LONGER a container-env value for v2-dev. The signed-principal HMAC
# secret is delivered memory-resident via the manager-neutral FILE seam: the host OpenBao materializer
# (deploy/v2-dev/openbao/) publishes it to a read-only tmpfs mount and compose sets
# REVIEWER_PROXY_SECRET_FILE=/run/tanaghom-secrets/reviewer_proxy_secret (max age 900s). Do NOT set a
# direct REVIEWER_PROXY_SECRET here — both together fail closed (ambiguous source).

# --- external human IAM (disabled until the private ZITADEL slice provisions it) ---
# Identity proof only. ZITADEL/other IdP claims never grant Tanaghom roles or capabilities.
TANAGHOM_OIDC_ENABLED=false
TANAGHOM_OIDC_ISSUER=http://iam.localhost:13210
# Server-only route on the existing private ZITADEL Docker network. This is never emitted as an issuer,
# redirect, logout URL, or token-validation authority.
TANAGHOM_OIDC_INTERNAL_BASE_URL=http://caddy:13210
TANAGHOM_IAM_NETWORK=tanaghom-iam-dev
# Operator-supplied non-secret ID from the public PKCE ZITADEL application. Never invent or seed it.
TANAGHOM_OIDC_CLIENT_ID=
# Browser-visible callback reached through the operator's local tunnel during development.
TANAGHOM_OIDC_REDIRECT_URI=http://127.0.0.1:13101/api/auth/callback
TANAGHOM_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:13101/
# TANAGHOM_SESSION_SECRET is intentionally absent. Before IAM is enabled, the ZITADEL activation
# slice must add iam_session_secret to the OpenBao materializer's exact allowlist in the existing
# read-only tmpfs mount; compose passes only TANAGHOM_SESSION_SECRET_FILE.
# A PKCE public client needs no client secret. If a confidential client is selected later, set only
# the non-secret file path variable after OpenBao materializes that credential.
# TANAGHOM_OIDC_CLIENT_SECRET_FILE stays unset for this public client.

# --- non-secret topology (defaults shown; override only with cause) ---
# DB_USER=tanaghom
# DB_NAME=tanaghom
# DB_PORT=5432
#
# Frozen, NOT parameterized: loopback ports 127.0.0.1:18110 (API) / 127.0.0.1:13101 (workbench) and the
# pinned DB image digest live in docker-compose.yml by contract (#389 decisions 1 & 3) — do not move them
# here.
