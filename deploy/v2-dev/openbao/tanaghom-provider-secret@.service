[Unit]
Description=Tanaghom v2-dev %i runtime secret materializer (OpenBao -> tmpfs)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=10001
Group=10001
UMask=0077
ExecStart=!/srv/tanaghom-dev/openbao/materialize-provider-secret.sh %i
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=tanaghom-secrets
RuntimeDirectoryMode=0500
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/tanaghom-secrets
StandardOutput=journal
StandardError=journal
