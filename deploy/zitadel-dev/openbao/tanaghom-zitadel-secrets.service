[Unit]
Description=Tanaghom developer ZITADEL secrets materializer (OpenBao -> tmpfs)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/srv/tanaghom-zitadel/openbao/materialize-zitadel.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=tanaghom-zitadel
RuntimeDirectoryMode=0500
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/tanaghom-zitadel
StandardOutput=journal
StandardError=journal
