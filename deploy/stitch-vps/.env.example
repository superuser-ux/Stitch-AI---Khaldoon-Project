# Tanaghom VPS deployment placeholder values — PLACEHOLDERS ONLY, never real secrets.
# Copy to deploy/stitch-vps/.env on the VPS (compose reads the .env sibling of
# docker-compose.yml) and replace the placeholders before starting the stack.

# Public entrypoint today. Leave as "_" for IP-only access; switch to your real
# domain later without changing the app container topology.
PUBLIC_SERVER_NAME=_
PUBLIC_BASE_URL=http://YOUR-SERVER-IP

# Internal service wiring. DB_PASSWORD is the SINGLE credential source: compose interpolates it
# into the DB container as POSTGRES_PASSWORD and into the gate API as DB_PASSWORD, so the two
# can never drift apart.
DB_USER=tanaghom
DB_NAME=tanaghom
DB_PASSWORD=change-me
DB_PORT=5432

# API / dashboard runtime.
API_BASE=http://gateapi:8000
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=replace-me
REVIEWER_PROXY_SECRET=replace-me
TANAGHOM_DEV_MODE=0
CLIENT_TRIAL_MODE=false

# Writer mode — LIVE means this stays EMPTY (or the line absent). The gate API treats ANY
# non-empty value as stub-truthy, including the string "0", so never write 0 here; write 1
# only for a deliberate stub-writer test window and clear it afterwards.
TANAGHOM_WRITER_STUB=

# Build identity (#202) — stamp the EXACT deployed revision at every deploy/update so
# /api/runtime reports it (the update procedure in README.md sets this for you):
#   git -C /path/to/tanaghom rev-parse --short HEAD
# Leave empty only if you accept the explicit "unknown" fallback.
TANAGHOM_BUILD_SHA=

# Future domain cutover:
# - set PUBLIC_SERVER_NAME to your real hostname
# - set PUBLIC_BASE_URL to the HTTPS URL once TLS is enabled

# #250 — restricted READ-ONLY SDAM (ResourceSpace) principal for live Edit-handoff reads.
# Leave empty to run without live SDAM reads (the UI truthfully shows "not configured";
# persisted readiness evidence still renders). Values come from the operator secret path
# (#187 discipline) — e.g. copy from the root-only /srv/tanaghom/secrets/rs_ro.env.
RESOURCESPACE_BASE_URL=
RESOURCESPACE_API_USER=
RESOURCESPACE_API_KEY=

# #259 S2 — least-privilege WRITE ResourceSpace principal (completed-edit registration).
# Field-scoped (F99/F100), create-at-Pending, no delete. Leave empty to keep registration
# unavailable (the API returns 503 "not configured"). Values come from the operator secret
# path (#187) — e.g. the root-only /srv/tanaghom/secrets/rs_rw.env.
RESOURCESPACE_RW_USER=
RESOURCESPACE_RW_KEY=
